<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- JARVIS task runner: background tasks, in parallel. Nice 10 and LowPriorityIO, which the tasks it starts inherit, let the voice agent come first for CPU and disk, so a reply isn't broken up by pauses; not ProcessType Background, which would keep them on the efficiency cores. PATH carries the toolchains tasks build and test with. Installed by make services-install (jarvis.setup_local), which fills in the label and the folders. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>${LABEL}</string>
    <key>WorkingDirectory</key><string>${ROOT}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${ROOT}/.venv/bin/python</string>
        <string>-m</string>
        <string>jarvis.tasks.runner</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>${HOME}/.local/bin:${HOME}/.venv/bin:/opt/homebrew/bin:/usr/local/go/bin:${NODE}/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>Nice</key><integer>10</integer>
    <key>LowPriorityIO</key><true/>
    <key>StandardOutPath</key><string>${ROOT}/logs/tasks.log</string>
    <key>StandardErrorPath</key><string>${ROOT}/logs/tasks.log</string>
</dict>
</plist>
