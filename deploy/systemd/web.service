# Web app and token endpoint for the phone and browsers, a systemd user unit. Label and folders are filled in by
# alfred.setup_local.
[Unit]
Description=Alfred web app (${LABEL})

[Service]
Type=exec
WorkingDirectory=${ROOT}
Environment="PATH=${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
Environment="ALFRED_HOME=${ALFRED_HOME}"
ExecStart="${ROOT}/.venv/bin/python" -m alfred.server
Restart=always
RestartSec=10
StandardOutput=append:${ALFRED_HOME}/logs/web.log
StandardError=append:${ALFRED_HOME}/logs/web.log

[Install]
WantedBy=default.target
