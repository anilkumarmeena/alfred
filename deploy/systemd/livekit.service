# LiveKit media server, localhost signalling, a systemd user unit. Label, folders and the livekit-server path are
# filled in by alfred.setup_local.
[Unit]
Description=Alfred LiveKit server (${LABEL})

[Service]
Type=exec
WorkingDirectory=${ROOT}
Environment="PATH=${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
Environment="ALFRED_HOME=${ALFRED_HOME}"
ExecStart="${LIVEKIT}" --config "${ALFRED_HOME}/secrets/livekit.yaml"
Restart=always
RestartSec=10
StandardOutput=append:${ALFRED_HOME}/logs/livekit.log
StandardError=append:${ALFRED_HOME}/logs/livekit.log

[Install]
WantedBy=default.target
