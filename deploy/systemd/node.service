# Alfred on a second machine (node mode), a systemd user unit: dials the main computer and runs the work it sends.
# Restart=always brings it back after a self-update or a crash. Nice=10 and the idle I/O class as for the task runner.
# PATH includes the toolchains jobs build with, and uv for updates. Label and folders are filled in by alfred.setup_local.
[Unit]
Description=Alfred second machine (${LABEL})

[Service]
Type=exec
WorkingDirectory=${ROOT}
Environment="PATH=${HOME}/.local/bin:${HOME}/.venv/bin:/usr/local/go/bin:${NODE}/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
Environment="ALFRED_HOME=${ALFRED_HOME}"
ExecStart="${ROOT}/.venv/bin/python" -m alfred.node serve
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=idle
StandardOutput=append:${ALFRED_HOME}/logs/node.log
StandardError=append:${ALFRED_HOME}/logs/node.log

[Install]
WantedBy=default.target
