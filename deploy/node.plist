<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- JARVIS on a second machine (node mode): dials the main computer and runs the work it sends. KeepAlive restarts it
after a self-update or a crash. Nice 10 and LowPriorityIO as for the task runner. PATH includes the toolchains jobs
build with, and uv for updates. Label and folders are filled in by jarvis.setup_local. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>${LABEL}</string>
    <key>WorkingDirectory</key><string>${ROOT}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${ROOT}/.venv/bin/python</string>
        <string>-m</string>
        <string>jarvis.node</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict><key>JARVIS_HOME</key><string>${JARVIS_HOME}</string><key>PATH</key><string>${HOME}/.local/bin:${HOME}/.venv/bin:/opt/homebrew/bin:/usr/local/go/bin:${NODE}/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>Nice</key><integer>10</integer>
    <key>LowPriorityIO</key><true/>
    <key>StandardOutPath</key><string>${LOGS}/node.log</string>
    <key>StandardErrorPath</key><string>${LOGS}/node.log</string>
</dict>
</plist>
