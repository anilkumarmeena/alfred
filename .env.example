# JARVIS settings. Copy to .env (uv run python -m jarvis.setup_local does it for you) and fill in.
# .env stays on your Mac: never commit it. README.md (Settings) says what each one does.
# The commented-out ones show their defaults: uncomment one only to change it.
# Your name, time zone, voice, speed, speech gate and task limit are changed in the app (Settings), and kept in the
# database; set here, one wins over the app's and the app only shows it.

# ── Who you are (Settings → About you) ─────────────────────────
# What JARVIS calls you. Empty: the first name on your Mac account
# JARVIS_USER_NAME=
# Your time zone, e.g. Europe/London. Empty: the Mac's
# JARVIS_TIMEZONE=

# ── Phone and LiveKit (setup_local generates the keys and passcode) ──
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
JARVIS_PASSCODE=
# LIVEKIT_URL=ws://127.0.0.1:7880
# JARVIS_WEB_PORT=8787

# ── Brain ──────────────────────────────────────────────────────
# JARVIS_CLAUDE_CLI=
# JARVIS_CLAUDE_CONFIG_DIR=secrets/claude
# JARVIS_CLI_MODEL=claude-opus-5-5
# JARVIS_LOOKUP_MODEL=claude-haiku-4-5-20251001
# JARVIS_EFFORT=low
# JARVIS_MAX_TOOL_ROUNDS=8
# JARVIS_APPROVAL_MINUTES=5

# ── Voice (voice, speed and speech gate: Settings → Voice) ──────
# JARVIS_STT=mlx-community/whisper-large-v3-turbo-q4
# JARVIS_TTS_VOICE=bm_george
# JARVIS_TTS_SPEED=1.05
# JARVIS_TURN_MIN_DELAY=0.9
# JARVIS_TURN_MAX_DELAY=4.0
# JARVIS_DENOISE=on
# JARVIS_DENOISE_ATTEN_DB=18
# JARVIS_SPEECH_GATE=enforce
# JARVIS_SPEECH_GATE_MIN_SPEECH_SECONDS=0.1
# JARVIS_SPEECH_GATE_MIN_SECONDS=0.3
# JARVIS_SPEECH_GATE_MIN_DBFS=-55
# JARVIS_SPEECH_GATE_NO_SPEECH=0.8
# JARVIS_SPEECH_GATE_WEAK_SPEECH_SECONDS=0.25
# JARVIS_SPEECH_GATE_SAVE_AUDIO=on
# JARVIS_SPEECH_GATE_AUDIO_KEEP=300

# ── Google ─────────────────────────────────────────────────────
# Path to the OAuth client's JSON file. Empty: the client_secret*.json in secrets/.
# The accounts themselves are in the database: uv run python -m jarvis.integrations.accounts
# GOOGLE_CLIENT_SECRET=

# ── Background tasks (how many at once: Settings → System) ─────
# JARVIS_MAX_TASKS=6
# JARVIS_TASK_MODEL=claude-opus-5-5
# JARVIS_TASK_EFFORT=high
# JARVIS_TASK_MAX_TURNS=150
# JARVIS_TASK_SEARCH_MODEL=claude-haiku-4-5-20251001
# JARVIS_TASK_HELPER_MODEL=claude-sonnet-5
# JARVIS_TASK_APPROVAL_HOURS=12
# Folders tasks may read but not change, comma-separated
# JARVIS_TASK_READ_DIRS=~/Desktop/projects
# JARVIS_NEW_PROJECTS_DIR=~/Desktop/projects

# ── Heartbeat ──────────────────────────────────────────────────
# JARVIS_HEARTBEAT=on
# JARVIS_HEARTBEAT_MINUTES=15
# JARVIS_HEARTBEAT_EVENT_MINUTES=30
# JARVIS_HEARTBEAT_QUIET_HOURS=23:00-08:00
# JARVIS_HEARTBEAT_TRIAGE=off
# JARVIS_HEARTBEAT_MODEL=

# ── Notifications ──────────────────────────────────────────────
# JARVIS_PUSH=on
# A mailto: or https: address push services may use to reach you. Empty: your default Google account's address
# JARVIS_PUSH_CONTACT=
JARVIS_APNS_KEY_ID=
JARVIS_APNS_TEAM_ID=
