# Alfred settings. Copy to .env (`uv run python -m alfred.setup_local` does it) and fill in. Never commit .env.
# Commented-out lines show defaults; uncomment only to change one. Full list: docs/configuration.md.
# Names, time zone, voice, speed, speech gate and task limit are also set in the app; a value here wins over it.

# ── Who you are (Settings → About you) ─────────────────────────
# What Alfred calls you. Empty: first name on your computer account
# ALFRED_USER_NAME=
# What your assistant goes by and answers to, e.g. Friday. Empty: Alfred
# ALFRED_ASSISTANT_NAME=
# Time zone name, e.g. Europe/London. Empty: the computer's
# ALFRED_TIMEZONE=

# ── Phone and LiveKit (setup_local generates the keys and passcode) ──
# LiveKit server credentials; moved into the vault on first start
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# First-setup passcode; becomes your login and is then removed from .env
ALFRED_PASSCODE=
# Local LiveKit server
# LIVEKIT_URL=ws://127.0.0.1:7880
# Port of the web app the phone and browsers use
# ALFRED_WEB_PORT=8787

# ── Brain ──────────────────────────────────────────────────────
# Path to a `claude` binary. Empty: the one bundled with claude-agent-sdk
# ALFRED_CLAUDE_CLI=
# Claude CLI config folder (holds Alfred's Claude login)
# ALFRED_CLAUDE_CONFIG_DIR=secrets/claude
# Voice brain model
# ALFRED_CLI_MODEL=claude-opus-5-5
# Voice brain's read-only lookup subagent model
# ALFRED_LOOKUP_MODEL=claude-haiku-4-5-20251001
# Voice brain effort; low keeps spoken turns quick
# ALFRED_EFFORT=low
# Max tool-call rounds per spoken turn
# ALFRED_MAX_TOOL_ROUNDS=8
# Minutes a risky shell command waits for your spoken yes
# ALFRED_APPROVAL_MINUTES=5

# ── Voice (voice, speed and speech gate: Settings → Voice) ──────
# Whisper model (Hugging Face repo)
# ALFRED_STT=mlx-community/whisper-large-v3-turbo-q4
# Kokoro voice: bm_* British male, bf_* British female, am_*/af_* American
# ALFRED_TTS_VOICE=bm_george
# Speech speed
# ALFRED_TTS_SPEED=1.05
# Seconds of silence that end your turn: when it sounds finished / at most, mid-thought
# ALFRED_TURN_MIN_DELAY=0.9
# ALFRED_TURN_MAX_DELAY=4.0
# Noise filter: on (everything), vad (VAD only) or off
# ALFRED_DENOISE=on
# Most the noise filter removes, in dB (0: no limit)
# ALFRED_DENOISE_ATTEN_DB=18
# Speech gate for phantom clips: enforce (drop), shadow (log only) or off
# ALFRED_SPEECH_GATE=enforce
# Speech gate thresholds (docs/voice.md)
# ALFRED_SPEECH_GATE_MIN_SPEECH_SECONDS=0.1
# ALFRED_SPEECH_GATE_MIN_SECONDS=0.3
# ALFRED_SPEECH_GATE_MIN_DBFS=-55
# ALFRED_SPEECH_GATE_NO_SPEECH=0.8
# ALFRED_SPEECH_GATE_WEAK_SPEECH_SECONDS=0.25
# Save each judged clip as WAV in logs/speech-gate-audio/ (default: on in shadow mode only)
# ALFRED_SPEECH_GATE_SAVE_AUDIO=on
# Newest saved clips to keep
# ALFRED_SPEECH_GATE_AUDIO_KEEP=300

# ── Google ─────────────────────────────────────────────────────
# OAuth client JSON path. Empty: the client_secret*.json in secrets/
# Accounts live in the database: uv run python -m alfred.integrations.accounts
# GOOGLE_CLIENT_SECRET=

# ── Background tasks (how many at once: Settings → System) ─────
# Tasks running at once (max 12); the rest queue
# ALFRED_MAX_TASKS=6
# Task model and effort
# ALFRED_TASK_MODEL=claude-opus-5-5
# ALFRED_TASK_EFFORT=high
# Max agent turns per task run
# ALFRED_TASK_MAX_TURNS=150
# Subagent models: read-only code searcher / test runner and web researcher
# ALFRED_TASK_SEARCH_MODEL=claude-haiku-4-5-20251001
# ALFRED_TASK_HELPER_MODEL=claude-sonnet-5
# Hours a task's risky-command request waits for your answer
# ALFRED_TASK_APPROVAL_HOURS=12
# Folders tasks may read but not change, comma-separated
# ALFRED_TASK_READ_DIRS=~/Desktop/projects
# Where a project registered by voice gets its folder
# ALFRED_NEW_PROJECTS_DIR=~/Desktop/projects

# ── Heartbeat ──────────────────────────────────────────────────
# Periodic check for new mail, meetings, tasks and more: on or off
# ALFRED_HEARTBEAT=on
# Minutes between checks
# ALFRED_HEARTBEAT_MINUTES=15
# How soon a meeting must start to be flagged, in minutes
# ALFRED_HEARTBEAT_EVENT_MINUTES=30
# Local hours with no checks or alerts (empty: never quiet)
# ALFRED_HEARTBEAT_QUIET_HOURS=23:00-08:00
# on: a model drops newsletters and noise from new mail and GitHub notifications
# ALFRED_HEARTBEAT_TRIAGE=off
# Triage model. Empty: ALFRED_CLI_MODEL
# ALFRED_HEARTBEAT_MODEL=

# ── Notifications ──────────────────────────────────────────────
# Send alerts and task updates to phones that enabled notifications
# ALFRED_PUSH=on
# mailto: or https: address push services may use to reach you. Empty: default Google account's address
# ALFRED_PUSH_CONTACT=
# APNs key id for the native app; moved into the vault on start (key file: secrets/apns_key.p8)
ALFRED_APNS_KEY_ID=
# Your Apple developer team id, for pushes to the native app
ALFRED_APNS_TEAM_ID=
